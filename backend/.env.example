# Server
PORT=3000
CRAWLER_PREVIEW=0

# App update policy
APP_LATEST_VERSION=1.0.8
APP_MINIMUM_VERSION=1.0.0
APP_LATEST_BUILD_NUMBER=9
APP_MINIMUM_BUILD_NUMBER=1
APP_FORCE_UPDATE=false
APP_STORE_URL=https://play.google.com/store/apps/details?id=com.aipod.app

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=aipod_db
DB_SYNC=true

# LLM provider
LLM_TYPE=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Grounding (Google Search) — Google AI Studio API key
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
GEMINI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/api/google/models/generate-content
GEMINI_MODEL=gemini-2.5-flash
THUMBNAIL_IMAGE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/images/generate/
THUMBNAIL_IMAGE_MODEL=gemini-2.5-flash-image
THUMBNAIL_IMAGE_QUALITY=high

# TTS (Cloud Text-to-Speech Chirp 3 HD)
AUDIO_OUTPUT_DIR=./audio-files
THUMBNAIL_OUTPUT_DIR=./thumbnails
CARD_NEWS_OUTPUT_DIR=./card-news-images

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=3600

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Pipeline Automation
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
MIN_ARTICLES=3
