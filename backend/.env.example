# Server
PORT=3000
CRAWLER_PREVIEW=0

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=aipod_db
DB_SYNC=true

# LLM provider
LLM_TYPE=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# TTS - Fish Speech (Docker: fishaudio/fish-speech:latest-server-cpu)
FISH_SPEECH_URL=http://localhost:8080
AUDIO_OUTPUT_DIR=./audio-files
